# ── Required ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:your-telegram-token

# ── Webhook ───────────────────────────────────────────────────────────────────
# A unique path token that makes the webhook URL hard to guess (letters/numbers/_ and -)
WEBHOOK_SECRET_PATH=crypto-price-hook

# Optional: extra header-level signature verification (recommended in production, min 8 chars)
TELEGRAM_WEBHOOK_SECRET_TOKEN=

# On Vercel this is auto-derived from VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL.
# Set explicitly when deploying outside Vercel or to override the auto-detected value.
WEBHOOK_BASE_URL=https://your-app.vercel.app

# Optional: protect the /api/setup-webhook POST endpoint
SETUP_WEBHOOK_SECRET=

# ── Durable storage (required for persistent theme state on Vercel) ────────────
# Add Vercel KV or Upstash Redis and paste the credentials here.
# Without these, theme state is stored in /tmp and lost on cold starts.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── CoinGecko ─────────────────────────────────────────────────────────────────
# Optional: comma-separated CoinGecko API keys for higher rate limits
COINGECKO_API_KEYS=

# ── Runtime (optional — sensible defaults shown) ──────────────────────────────
NODE_ENV=production
BOT_MODE=webhook
PORT=3000
CHAT_MIN_INTERVAL_MS=2000
RATE_LIMIT_IDLE_TTL_MS=21600000
RENDER_MAX_CONCURRENCY=4

# ── Local development only ────────────────────────────────────────────────────
DATA_DIR=./data
