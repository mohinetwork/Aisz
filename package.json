{
  "name": "telegram-crypto-price-bot",
  "version": "1.0.0",
  "description": "Telegram bot that renders crypto price cards for /btc /eth /sol /ltc /top",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.api.json",
    "start": "node dist/index.js",
    "check": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.api.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "telegram",
    "crypto",
    "bot",
    "telegraf"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.15.0",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "playwright-core": "^1.40.1",
    "telegraf": "^4.16.3",
    "zod": "^4.3.6",
    "@sparticuz/chromium-min": "^123.0.0",
    "@vercel/node": "^3.0.0"

  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^25.6.0",
    "axios-mock-adapter": "^2.1.0",
    "jsdom": "^29.0.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  }
}
